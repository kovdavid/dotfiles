[global]
    follow = mouse

    width = (340, 800)
    height = 120
    offset = 16x16
    origin = top-right
    notification_limit = 5

    font = DejaVu Sans Mono 16
    line_height = 4
    padding = 14
    horizontal_padding = 14
    text_icon_padding = 12

    frame_width = 2
    frame_color = "#89b4fa"
    separator_color = frame
    gap_size = 8

    corner_radius = 12
    transparency = 5
